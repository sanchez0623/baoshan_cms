# 推荐：单独使用 DATABASE_URL
DATABASE_URL=mysql://root:password@127.0.0.1:3306/baoshan_cms

# 或者分别配置 MySQL 连接参数（二选一）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=baoshan_cms

# 可选：自定义后台登录 Cookie 签名密钥；未设置时会回退为数据库连接信息
# CMS_SESSION_SECRET=replace-with-a-long-random-string
